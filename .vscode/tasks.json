{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "shell",
			"command": "zig",
			"args": ["build", "-Doptimize=ReleaseSmall"],
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "test",
			"type": "shell",
			"command": "nu",
			"args": [ "-c", "glob *_test.nu | par-each { |t| let r = (do { ^nu $t } | complete); print $\"($r.stdout)($r.stderr)\"; $r.exit_code } | math max | exit $in" ],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}
